"use client";

import { useEffect, useState } from "react";

type Win = {
  player: string;
  amount: number;
  game: string;
};

export default function LiveWins() {

  const [wins,setWins] = useState<Win[]>([]);

  async function loadWins(){
    try{
      const r = await fetch("/api/activity/wins");
      const j = await r.json();
      setWins(j.items || []);
    }catch{}
  }

  useEffect(()=>{
    loadWins();
    const t = setInterval(loadWins,8000);
    return ()=>clearInterval(t);
  },[]);

  if(!wins.length) return null;

  const items = [...wins,...wins];

  return(
    <div style={wrap}>
      <div style={track}>
        {items.map((w,i)=>(
          <div key={i} style={item}>
            <span style={player}>{w.player}</span>
            <span style={won}> won </span>
            <span style={amount}>${w.amount}</span>
            <span style={game}> on {w.game}</span>
          </div>
        ))}
      </div>
    </div>
  )
}

const wrap={
  overflow:"hidden",
  borderRadius:14,
  background:"#13202a",
  border:"1px solid rgba(255,255,255,0.05)",
  padding:"10px 0",
  margin:"0 0 18px 0",
  width:"100%"
};

const track={
  display:"flex",
  gap:40,
  width:"max-content",
  animation:"scroll 30s linear infinite"
} as any;
const item={
  color:"#d7e0ea",
  fontWeight:700,
  whiteSpace:"nowrap"
};

const player={color:"#86efac"};

const won={color:"#8ca3b8"};

const amount={
  color:"#00e701",
  marginLeft:6,
  marginRight:6
};

const game={color:"#93c5fd"};
