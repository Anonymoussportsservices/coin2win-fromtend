"use client";

import { useEffect, useMemo, useState } from "react";

type LiveFeedItem = {
  id?: string;
  user?: string;
  display_user?: string;
  message?: string;
  game?: string;
  game_name?: string;
  payout?: number;
  amount_usd?: number;
  multiplier?: number | null;
  source?: string;
  created_at?: string;
  occurred_at?: string;
  is_big_win?: boolean;
};

function fmtMoney(value: number | null | undefined) {
  return `$${Number(value || 0).toFixed(2)}`;
}

function normalizeGameLabel(item: LiveFeedItem) {
  const raw = String(item.game_name || item.game || "Game").toLowerCase();
  if (raw === "crash") return "Crash";
  if (raw === "dice") return "Dice";
  return raw.charAt(0).toUpperCase() + raw.slice(1);
}

export default function LobbyLiveFeed() {
  const [items, setItems] = useState<LiveFeedItem[]>([]);
  const [index, setIndex] = useState(0);

  useEffect(() => {
    let mounted = true;

    async function loadFeed() {
      try {
        await fetch("/api/studio/live-wins/seed", {
          method: "POST",
          headers: { Accept: "application/json" },
        }).catch(() => null);

        const res = await fetch("/api/studio/live-wins?limit=18", {
          cache: "no-store",
          headers: { Accept: "application/json" },
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(typeof data?.detail === "string" ? data.detail : "Failed to load live feed");
        }

        const nextItems: LiveFeedItem[] = Array.isArray(data?.items) ? data.items : [];

        if (!mounted) return;
        setItems(nextItems);
      } catch {
        if (!mounted) return;
        setItems([]);
      }
    }

    loadFeed();
    const refreshTimer = setInterval(loadFeed, 5000);

    return () => {
      mounted = false;
      clearInterval(refreshTimer);
    };
  }, []);

  useEffect(() => {
    if (items.length <= 1) return;

    const rotateTimer = setInterval(() => {
      setIndex((prev) => (prev + 1) % items.length);
    }, 3200);

    return () => clearInterval(rotateTimer);
  }, [items]);

  const visible = useMemo(() => {
    if (!items.length) return [];

    const ordered = [...items.slice(index), ...items.slice(0, index)];
    const realItems = ordered.filter((item) => item.source === "real");
    const fakeItems = ordered.filter((item) => item.source !== "real");

    return [...realItems, ...fakeItems].slice(0, 6);
  }, [items, index]);

  return (
    <section className="w-full max-w-full overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/70 p-3 shadow-sm sm:rounded-3xl sm:p-5">
      <div className="mb-3 flex items-end justify-between gap-3">
        <div className="min-w-0">
          <div className="text-[11px] font-extrabold uppercase tracking-[0.18em] text-emerald-400">
            Live Feed
          </div>
          <h2 className="mt-1 text-lg font-bold text-white sm:text-xl">
            Recent player action
          </h2>
          <p className="mt-1 text-xs text-slate-400 sm:text-sm">
            Real-time wins and cashouts across Coin2Win.
          </p>
        </div>
      </div>

      {visible.length === 0 ? (
        <div className="rounded-2xl border border-dashed border-slate-700 bg-slate-950/70 p-4 text-sm text-slate-400">
          Live feed warming up...
        </div>
      ) : (
        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-6">
          {visible.map((item, i) => {
            const gameLabel = normalizeGameLabel(item);
            const payout = Number(item.payout || 0);
            const amount = Number(item.amount_usd || 0);
            const text =
              item.message ||
              `${item.display_user || item.user || "Player"} won ${fmtMoney(payout || amount)} on ${gameLabel}`;

            return (
              <div
                key={item.id ?? `${gameLabel}-${item.user ?? "player"}-${i}`}
                className={`rounded-2xl border p-4 shadow-sm transition ${
                  item.is_big_win
                    ? "border-emerald-500/30 bg-[linear-gradient(180deg,#183328_0%,#13202a_100%)]"
                    : "border-white/5 bg-[linear-gradient(180deg,#1a2c38_0%,#13202a_100%)]"
                }`}
              >
                <div className="flex items-center justify-between gap-2">
                  <span className="inline-flex rounded-full border border-sky-500/20 bg-sky-500/10 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wide text-sky-300">
                    {gameLabel}
                  </span>

                  <span
                    className={`text-xs font-extrabold ${
                      item.multiplier != null ? "text-emerald-300" : "text-slate-300"
                    }`}
                  >
                    {item.multiplier != null
                      ? `${Number(item.multiplier).toFixed(2)}x`
                      : "WIN"}
                  </span>
                </div>

                <div className="mt-3 text-sm font-semibold leading-6 text-white">
                  {text}
                </div>

                <div className="mt-3 text-lg font-black text-emerald-300">
                  {fmtMoney(payout || amount)}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>
  );
}
