"use client";

import type { CSSProperties } from "react";
import { useEffect, useMemo, useState } from "react";

const API = "/api";

type CrashHistoryRound = {
  id: number;
  crash_point?: number | null;
};

type RoundBet = {
  bet_id: number;
  player: string;
  amount: number;
  auto_cashout?: number | null;
  status: string;
  payout: number;
  cashout_multiplier?: number | null;
};
type FeedItem = {
  id?: string;
  player: string;
  user?: string;
  message?: string;
  game: string;
  amount: number;
  payout: number;
  multiplier?: number | null;
  status: string;
};

function fmtMoney(n: number | null | undefined) {
  return `$${Number(n || 0).toFixed(2)}`;
}

function shortPlayer(name: string | null | undefined) {
  return String(name || "Player");
}

export default function LobbyLiveFeed() {
  const [items, setItems] = useState<FeedItem[]>([]);
  const [index, setIndex] = useState(0);

  useEffect(() => {
    async function loadFeed() {
      try {
        const historyRes = await fetch(`${API}/studio/crash-global/history`, {
          headers: { Accept: "application/json" },
          cache: "no-store",
        });

        const historyData = await historyRes.json().catch(() => ({}));
        const rounds: CrashHistoryRound[] = Array.isArray(historyData?.rounds)
          ? historyData.rounds.slice(0, 4)
          : [];

        const roundResults = await Promise.all(
          rounds.map(async (round) => {
            const res = await fetch(`${API}/studio/crash-global/round-bets/${round.id}`, {
              headers: { Accept: "application/json" },
              cache: "no-store",
            });
            const data = await res.json().catch(() => ({}));
            return Array.isArray(data?.bets) ? data.bets : [];
          })
        );

        const feed: FeedItem[] = roundResults
          .flat()
          .filter((bet: RoundBet) => {
            const s = String(bet.status || "").toLowerCase();
            return ["cashed_out", "won", "win", "lost", "crashed", "completed"].includes(s);
          })
          .map((bet: RoundBet) => ({
            id: `crash-${bet.bet_id}`,
            player: shortPlayer(bet.player),
            game: "Crash",
            amount: Number(bet.amount || 0),
            payout: Number(bet.payout || 0),
            multiplier: bet.cashout_multiplier ?? bet.auto_cashout ?? null,
            status: String(bet.status || ""),
          }))
          .sort((a, b) => b.payout - a.payout)
          .slice(0, 18);

        setItems(feed);
      } catch {
        setItems([]);
      }
    }

    loadFeed();
    const t = setInterval(loadFeed, 10000);
    return () => clearInterval(t);
  }, []);

  useEffect(() => {
    if (!items.length) return;
    const t = setInterval(() => {
      setIndex((prev) => (prev + 1) % items.length);
    }, 2200);
    return () => clearInterval(t);
  }, [items]);

  const visible = useMemo(() => {
    if (!items.length) return [];
    const ordered = [...items.slice(index), ...items.slice(0, index)];
    return ordered.slice(0, 6);
  }, [items, index]);

  return (
    <section style={sectionWrap}>
      <div style={headerRow}>
        <div>
          <div style={eyebrow}>LIVE FEED</div>
          <h3 style={title}>Recent player action</h3>
        </div>
      </div>

      <div style={tickerWrap}>
        {visible.length ? (
          visible.map((item) => (
                          
       <div
         key={item.id ?? `${item.game}-${item.user ?? item.player}-${item.payout}-${item.multiplier ?? item.status}`}
         style={feedCard}
>
              <div style={feedMain}>
                <span style={playerStyle}>
              {item.user ? item.user : item.player} won {fmtMoney(item.payout || item.amount)}  
                </span>
                <span
                  style={{
                    ...statusStyle,
                    color:
                      String(item.status).toLowerCase() === "cashed_out" ||
                      String(item.status).toLowerCase() === "won"
                        ? "#86efac"
                        : "#fca5a5",
                  }}
                >
                  {item.multiplier ? `${Number(item.multiplier).toFixed(2)}x` : item.status}
                </span>
              </div>
            </div>
          ))
        ) : (
          <div style={emptyStyle}>Live feed warming up...</div>
        )}
      </div>
    </section>
  );
}

const sectionWrap: CSSProperties = {
  display: "grid",
  gap: 14,
  width: "100%",
};

const headerRow: CSSProperties = {
  display: "flex",
  alignItems: "center",
  justifyContent: "space-between",
};

const eyebrow: CSSProperties = {
  color: "#86efac",
  fontSize: 11,
  fontWeight: 900,
  letterSpacing: "0.12em",
};

const title: CSSProperties = {
  margin: "6px 0 0 0",
  fontSize: 20,
  fontWeight: 800,
  color: "#fff",
};

const tickerWrap: CSSProperties = {
  display: "grid",
  gridTemplateColumns: "repeat(6, minmax(0, 1fr))",
  gap: 12,
};

const feedCard: CSSProperties = {
  background: "linear-gradient(180deg, #1a2c38 0%, #13202a 100%)",
  border: "1px solid rgba(255,255,255,0.05)",
  borderRadius: 16,
  padding: 14,
  display: "grid",
  gap: 10,
  minHeight: 96,
};

const feedTop: CSSProperties = {
  display: "flex",
  alignItems: "center",
  justifyContent: "space-between",
  gap: 8,
};

const playerStyle: CSSProperties = {
  color: "#fff",
  fontSize: 15,
  fontWeight: 800,
  lineHeight: 1.35,
};

const gameBadge: CSSProperties = {
  background: "rgba(0,231,1,0.12)",
  color: "#86efac",
  border: "1px solid rgba(0,231,1,0.18)",
  borderRadius: 999,
  padding: "4px 8px",
  fontSize: 10,
  fontWeight: 800,
};

const feedMain: CSSProperties = {
  display: "grid",
  gap: 4,
};

const amountStyle: CSSProperties = {
  color: "#fff",
  fontSize: 22,
  fontWeight: 900,
};

const statusStyle: CSSProperties = {
  fontSize: 12,
  fontWeight: 800,
};

const emptyStyle: CSSProperties = {
  background: "#1a2c38",
  border: "1px solid rgba(255,255,255,0.05)",
  borderRadius: 16,
  padding: 16,
  color: "#9fb0bf",
};
