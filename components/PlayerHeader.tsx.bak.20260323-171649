"use client"

import Link from "next/link"
import { usePathname } from "next/navigation"
import { useEffect, useState } from "react"
import { clearAuth, getStoredUser } from "@/lib/auth"

type WalletData = {
  user_id: string
  balance_total: number
  balance_available: number
  balance_pending: number
}

function money(v?: number) {
  if (typeof v !== "number" || Number.isNaN(v)) return "$0.00"
  return `$${v.toFixed(2)}`
}

const navItems = [
  { label: "Casino", href: "/casino" },
  { label: "Originals", href: "/casino/originals" },
  { label: "Slots", href: "/casino/slots" },
  { label: "Live Dealer", href: "/casino/live" },
  { label: "Table Games", href: "/casino/table-games" },
  { label: "Cashier", href: "/cashier" },
  { label: "History", href: "/account/history" },
]

export default function PlayerHeader() {
  const pathname = usePathname()
  const [wallet, setWallet] = useState<WalletData | null>(null)
  const [loggedIn, setLoggedIn] = useState(false)

  useEffect(() => {
    async function loadWallet() {
      const user = getStoredUser()
      if (!user?.user_id) {
        setLoggedIn(false)
        setWallet(null)
        return
      }

      setLoggedIn(true)

      try {
        const res = await fetch(`/api/wallet/${user.user_id}`, { cache: "no-store" })
        const data = await res.json().catch(() => null)
        if (res.ok) setWallet(data)
      } catch {
        setWallet(null)
      }
    }

    loadWallet()
  }, [pathname])

  return (
    <header className="mb-8 rounded-3xl border border-slate-800 bg-slate-900/70 p-5 shadow-sm">
      <div className="flex flex-col gap-5">
        <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <Link href="/" className="block">
              <p className="text-xs font-semibold uppercase tracking-[0.22em] text-sky-400">
                Coin2Win
              </p>
              <h1 className="mt-2 text-2xl font-bold tracking-tight md:text-3xl">
                Crypto Casino Platform
              </h1>
            </Link>
          </div>

          <div className="flex flex-wrap gap-3">
            {loggedIn && wallet && (
              <>
                <div className="rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3">
                  <div className="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                    Available
                  </div>
                  <div className="mt-1 text-sm font-bold text-white">
                    {money(wallet.balance_available)}
                  </div>
                </div>

                <div className="rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3">
                  <div className="text-[11px] font-semibold uppercase tracking-wide text-slate-500">
                    Pending
                  </div>
                  <div className="mt-1 text-sm font-bold text-amber-300">
                    {money(wallet.balance_pending)}
                  </div>
                </div>
              </>
            )}

            {!loggedIn ? (
              <>
                <Link
                  href="/login"
                  className="rounded-2xl border border-slate-700 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
                >
                  Login
                </Link>
                <Link
                  href="/register"
                  className="rounded-2xl bg-sky-500 px-4 py-3 text-sm font-semibold text-white transition hover:bg-sky-400"
                >
                  Register
                </Link>
              </>
            ) : (
              <button
                onClick={() => {
                  clearAuth()
                  window.location.href = "/"
                }}
                className="rounded-2xl border border-red-500/40 px-4 py-3 text-sm font-semibold text-red-300 transition hover:bg-red-500 hover:text-white"
              >
                Logout
              </button>
            )}
          </div>
        </div>

        <nav className="flex gap-3 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          {navItems.map((item) => {
            const active = pathname === item.href
            return (
              <Link
                key={item.href}
                href={item.href}
                className={`rounded-full px-4 py-2 text-sm font-semibold transition ${
                  active
                    ? "bg-sky-500 text-white"
                    : "border border-slate-700 bg-slate-950 text-slate-300 hover:bg-slate-800"
                }`}
              >
                {item.label}
              </Link>
            )
          })}
        </nav>
      </div>
    </header>
  )
}
