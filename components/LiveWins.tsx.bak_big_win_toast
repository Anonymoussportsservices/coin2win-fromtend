"use client";

import { useEffect, useMemo, useState, type CSSProperties } from "react";

type LiveWinItem = {
  id: string;
  event_type?: string;
  game?: string;
  game_key?: string;
  game_name?: string;
  user?: string;
  user_id?: string;
  display_user?: string;
  message: string;
  payout: number;
  stake?: number;
  amount_usd?: number;
  multiplier?: number | null;
  provider?: string;
  source?: string;
  created_at?: string;
  occurred_at?: string;
  is_big_win?: boolean;
};

export default function LiveWins() {
  const [items, setItems] = useState<LiveWinItem[]>([]);
  const [index, setIndex] = useState(0);

  useEffect(() => {
    let mounted = true;

    async function loadFeed() {
      try {
        await fetch("/api/studio/live-wins/seed", {
          method: "POST",
          headers: { Accept: "application/json" },
        }).catch(() => null);

        const res = await fetch("/api/studio/live-wins?limit=12", {
          cache: "no-store",
          headers: { Accept: "application/json" },
        });

        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(
            typeof data?.detail === "string" ? data.detail : "Failed to load live wins"
          );
        }

        const nextItems: LiveWinItem[] = Array.isArray(data?.items)
          ? data.items
              .map((item: any) => ({
                id: String(item.id ?? `${item.game}-${item.user}-${item.created_at ?? Math.random()}`),
                game: String(item.game ?? ""),
                user: String(item.user ?? "Player"),
                message: String(
                  item.message ??
                    `${item.user ?? "Player"} won $${Number(item.payout ?? 0).toFixed(2)} on ${item.game ?? "Game"}${
                      item.multiplier != null ? ` at ${Number(item.multiplier).toFixed(2)}x` : ""
                    }`
                ),
                payout: Number(item.payout ?? 0),
                multiplier: item.multiplier != null ? Number(item.multiplier) : null,
                source: item.source ? String(item.source) : undefined,
                created_at: item.created_at ? String(item.created_at) : undefined,
              }))
              .filter((item: LiveWinItem) => item.message.trim().length > 0)
          : [];

        if (!mounted) return;
        setItems(nextItems);
      } catch {
        if (!mounted) return;
        setItems([]);
      }
    }

    loadFeed();
    const refreshTimer = setInterval(loadFeed, 3000);

    return () => {
      mounted = false;
      clearInterval(refreshTimer);
    };
  }, []);

  useEffect(() => {
    if (!items.length) return;
    const rotateTimer = setInterval(() => {
      setIndex((prev) => (prev + 1) % items.length);
    }, 3000);

    return () => clearInterval(rotateTimer);
  }, [items]);

  const visible = useMemo(() => {
    if (!items.length) return [];
    const ordered = [...items.slice(index), ...items.slice(0, index)];
    return ordered.slice(0, 4);
  }, [items, index]);

  return (
    <section style={sectionWrap}>
      <div style={headerRow}>
        <div>
          <div style={eyebrow}>LIVE FEED</div>
          <h3 style={title}>Recent player action</h3>
        </div>
      </div>

      <div style={tickerWrap}>
        {visible.length ? (
          visible.map((item) => (
            <div key={item.id} style={{ ...feedCard, ...(item.is_big_win ? bigWinCard : {}) }}>
              <div style={feedTop}>
                <span style={gameBadge}>{item.game_name ?? item.game ?? item.game_key ?? "Game"}</span>
              </div>

              <div style={feedMain}>
                <span style={playerStyle}>{item.message}</span>
                <span style={metaStyle}>
                  {item.multiplier != null ? `${Number(item.multiplier).toFixed(2)}x` : "Win"}
                </span>
              </div>
            </div>
          ))
        ) : (
          <div style={emptyCard}>No live wins yet.</div>
        )}
      </div>
    </section>
  );
}

const sectionWrap: CSSProperties = {
  display: "grid",
  gap: 12,
  marginBottom: 18,
};

const headerRow: CSSProperties = {
  display: "flex",
  justifyContent: "space-between",
  alignItems: "center",
  gap: 12,
};

const eyebrow: CSSProperties = {
  color: "#7f8fa4",
  fontSize: 11,
  fontWeight: 800,
  textTransform: "uppercase",
  letterSpacing: "0.12em",
  marginBottom: 4,
};

const title: CSSProperties = {
  margin: 0,
  color: "#ffffff",
  fontSize: 20,
  fontWeight: 800,
};

const tickerWrap: CSSProperties = {
  display: "grid",
  gap: 10,
  gridTemplateColumns: "repeat(auto-fit, minmax(240px, 1fr))",
};

const feedCard: CSSProperties = {
  background: "linear-gradient(180deg, #1a2c38 0%, #13202a 100%)",
  border: "1px solid rgba(255,255,255,0.06)",
  borderRadius: 16,
  padding: "12px 14px",
  display: "grid",
  gap: 8,
  boxShadow: "0 10px 24px rgba(0,0,0,0.18)",
};

const bigWinCard: CSSProperties = {
  border: "1px solid rgba(0,231,1,0.35)",
  boxShadow: "0 0 0 1px rgba(0,231,1,0.18), 0 12px 30px rgba(0,231,1,0.18)",
};

const feedTop: CSSProperties = {
  display: "flex",
  justifyContent: "space-between",
  alignItems: "center",
  gap: 8,
};

const gameBadge: CSSProperties = {
  display: "inline-flex",
  alignItems: "center",
  justifyContent: "center",
  borderRadius: 999,
  padding: "4px 8px",
  fontSize: 11,
  fontWeight: 800,
  color: "#93c5fd",
  background: "rgba(59,130,246,0.14)",
  border: "1px solid rgba(59,130,246,0.22)",
  textTransform: "uppercase",
  letterSpacing: "0.04em",
};

const feedMain: CSSProperties = {
  display: "grid",
  gap: 6,
};

const playerStyle: CSSProperties = {
  color: "#ffffff",
  fontSize: 14,
  fontWeight: 700,
  lineHeight: 1.4,
};

const metaStyle: CSSProperties = {
  color: "#86efac",
  fontSize: 12,
  fontWeight: 800,
};

const emptyCard: CSSProperties = {
  background: "#13202a",
  border: "1px solid rgba(255,255,255,0.05)",
  borderRadius: 16,
  padding: "14px 16px",
  color: "#9fb0bf",
  fontSize: 13,
};
