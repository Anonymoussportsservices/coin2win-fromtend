"use client";

import { useEffect, useState, type CSSProperties } from "react";
import PlayerShell from "@/components/PlayerShell";
import { getStoredUser } from "@/lib/auth";
import { API_ENDPOINTS, apiGet } from "@/lib/gameApi";

type DiceBet = {
  id: number;
  amount_usd: number;
  condition: string;
  target: number;
  roll: number;
  win: boolean;
  payout: number;
  created_at?: string;
};

type CrashBet = {
  id: number;
  round_id?: number;
  amount_usd: number;
  auto_cashout?: number | null;
  status: string;
  payout: number;
  created_at?: string;
};

export default function BetsPage() {
  const user = getStoredUser();
  const userId = user?.user_id ?? "";

  const [diceBets, setDiceBets] = useState<DiceBet[]>([]);
  const [crashBets, setCrashBets] = useState<CrashBet[]>([]);
  const [error, setError] = useState("");

  useEffect(() => {
    async function load() {
      if (!userId) return;

      try {
        const [diceData, crashData] = await Promise.all([
          apiGet(API_ENDPOINTS.diceBets(userId)),
          apiGet(API_ENDPOINTS.crashGlobalMyBets(userId)).catch(() => ({ bets: [] })),
        ]);

        setDiceBets((diceData?.bets ?? []).slice(0, 20));
        setCrashBets((crashData?.bets ?? []).slice(0, 20));
      } catch (err) {
        setError(err instanceof Error ? err.message : "Failed to load bets");
      }
    }

    load();
  }, [userId]);

  return (
    <PlayerShell
      title="My Bets"
      subtitle="Review your recent Crash and Dice activity."
    >
      <div style={wrapStyle}>
        {error ? <div style={errorStyle}>{error}</div> : null}

        <div style={gridStyle}>
          <div style={cardStyle}>
            <h3 style={cardTitleStyle}>Crash Bets</h3>

            <div style={tableWrapStyle}>
              <table style={tableStyle}>
                <thead>
                  <tr>
                    <th style={thStyle}>Bet</th>
                    <th style={thStyle}>Amount</th>
                    <th style={thStyle}>Status</th>
                    <th style={thStyle}>Payout</th>
                  </tr>
                </thead>
                <tbody>
                  {crashBets.length ? (
                    crashBets.map((bet) => (
                      <tr key={bet.id}>
                        <td style={tdStyle}>{bet.id}</td>
                        <td style={tdStyle}>${Number(bet.amount_usd ?? 0).toFixed(2)}</td>
                        <td style={tdStyle}>{bet.status}</td>
                        <td style={tdStyle}>${Number(bet.payout ?? 0).toFixed(2)}</td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td style={tdStyle} colSpan={4}>No crash bets yet.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>

          <div style={cardStyle}>
            <h3 style={cardTitleStyle}>Dice Bets</h3>

            <div style={tableWrapStyle}>
              <table style={tableStyle}>
                <thead>
                  <tr>
                    <th style={thStyle}>Bet</th>
                    <th style={thStyle}>Amount</th>
                    <th style={thStyle}>Result</th>
                    <th style={thStyle}>Payout</th>
                  </tr>
                </thead>
                <tbody>
                  {diceBets.length ? (
                    diceBets.map((bet) => (
                      <tr key={bet.id}>
                        <td style={tdStyle}>{bet.id}</td>
                        <td style={tdStyle}>${Number(bet.amount_usd ?? 0).toFixed(2)}</td>
                        <td style={tdStyle}>{bet.win ? "Win" : "Loss"}</td>
                        <td style={tdStyle}>${Number(bet.payout ?? 0).toFixed(2)}</td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td style={tdStyle} colSpan={4}>No dice bets yet.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </PlayerShell>
  );
}

const wrapStyle: CSSProperties = {
  width: "100%",
  maxWidth: "100%",
  margin: "0 auto",
  display: "grid",
  gap: 18,
  boxSizing: "border-box",
};

const gridStyle: CSSProperties = {
  display: "grid",
  gridTemplateColumns: "1fr",
  gap: 16,
};

const cardStyle: CSSProperties = {
  background: "#1a2c38",
  border: "1px solid rgba(255,255,255,0.05)",
  borderRadius: 18,
  padding: 16,
  boxShadow: "0 14px 40px rgba(0,0,0,0.18)",
  width: "100%",
  boxSizing: "border-box",
};

const cardTitleStyle: CSSProperties = {
  margin: "0 0 14px 0",
  color: "#fff",
  fontSize: 20,
  fontWeight: 800,
};

const tableWrapStyle: CSSProperties = {
  overflowX: "auto",
};

const tableStyle: CSSProperties = {
  width: "100%",
  borderCollapse: "collapse",
};

const thStyle: CSSProperties = {
  textAlign: "left",
  padding: "10px 8px",
  color: "#9fb0bf",
  fontSize: 12,
  textTransform: "uppercase",
  borderBottom: "1px solid rgba(255,255,255,0.06)",
};

const tdStyle: CSSProperties = {
  padding: "12px 8px",
  color: "#fff",
  fontSize: 14,
  borderBottom: "1px solid rgba(255,255,255,0.05)",
};

const errorStyle: CSSProperties = {
  background: "rgba(239,68,68,0.12)",
  color: "#fecaca",
  border: "1px solid rgba(239,68,68,0.22)",
  borderRadius: 12,
  padding: "10px 12px",
  fontWeight: 700,
};
