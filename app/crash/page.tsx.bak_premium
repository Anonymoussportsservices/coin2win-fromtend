const resultBannerStyle = (win?: boolean): CSSProperties => ({ display: "inline-flex", alignItems: "center", justifyContent: "center", minWidth: "120px", padding: "10px 14px", borderRadius: "999px", fontWeight: 900, fontSize: "14px", marginBottom: "16px", background: win ? "rgba(34,197,94,0.16)" : "rgba(239,68,68,0.16)", color: win ? "#86efac" : "#fca5a5", border: win ? "1px solid rgba(34,197,94,0.28)" : "1px solid rgba(239,68,68,0.28)" });
const kvListStyle: CSSProperties = { display: "grid", gap: "10px" };
const kvRowStyle: CSSProperties = { display: "flex", justifyContent: "space-between", gap: "12px", padding: "10px 0", borderBottom: "1px solid rgba(255,255,255,0.06)" };
const tableWrapStyle: CSSProperties = { overflowX: "auto" };
const tableStyle: CSSProperties = { width: "100%", borderCollapse: "collapse" };
const thStyle: CSSProperties = { textAlign: "left", padding: "12px 10px", color: "#94a3b8", fontSize: "12px", textTransform: "uppercase", borderBottom: "1px solid rgba(255,255,255,0.08)" };
const tdStyle: CSSProperties = { padding: "12px 10px", borderBottom: "1px solid rgba(255,255,255,0.06)", color: "#e5e7eb", fontSize: "14px", verticalAlign: "top" };
const statusPillStyle = (status: string): CSSProperties => {
  const s = status.toLowerCase();
  const isPositive = s === "won" || s === "completed" || s === "cashed_out";
  const isNegative = s === "lost" || s === "crashed";
  return {
    display: "inline-block",
    padding: "6px 10px",
    borderRadius: "999px",
    fontSize: "12px",
    fontWeight: 800,
    background: isPositive ? "rgba(34,197,94,0.14)" : isNegative ? "rgba(239,68,68,0.14)" : "rgba(148,163,184,0.14)",
    color: isPositive ? "#86efac" : isNegative ? "#fca5a5" : "#cbd5e1",
  };
};
const emptyStyle: CSSProperties = { color: "#94a3b8" };
const hashStyle: CSSProperties = { maxWidth: "280px", overflowWrap: "anywhere", textAlign: "right" };
const toggleRowStyle: CSSProperties = { display: "flex", justifyContent: "space-between", alignItems: "center", gap: "12px", cursor: "pointer" };
const autoBoxStyle: CSSProperties = { display: "grid", gap: "12px", marginTop: "10px" };
