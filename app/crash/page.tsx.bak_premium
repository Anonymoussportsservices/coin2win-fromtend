"use client";

import { useEffect, useMemo, useState, type CSSProperties } from "react";
import { useRouter } from "next/navigation";
import { API_ENDPOINTS, apiGet, apiPost } from "../../lib/gameApi";
import { getStoredUser, type AuthUser } from "../../lib/auth";
import { useWallet } from "../../lib/useWallet";
import PlayerShell from "@/components/PlayerShell";

type CrashBet = {
  id: number;
  amount_usd: number;
  auto_cashout?: number | null;
  crash_point?: number;
  status?: string;
  payout?: number;
  created_at?: string;
};

type CrashBetsResponse = {
  user_id: string;
  count: number;
  bets: CrashBet[];
};

type CrashRound = {
  id: number;
  crash_point: number;
  status: string;
  nonce?: number;
  server_seed_hash?: string;
  client_seed?: string;
  created_at?: string;
  started_at?: string;
  ended_at?: string;
};

type CrashRoundsResponse = {
  user_id: string;
  count: number;
  rounds: CrashRound[];
};

type CrashBetResponse = {
  ok?: boolean;
  round_id?: number;
  bet_id?: number;
  user_id?: string;
  amount_usd?: number;
  auto_cashout?: number;
  crash_point?: number | null;
  status?: string;
  payout?: number;
  cashout_multiplier?: number;
  server_seed_hash?: string;
  client_seed?: string;
  nonce?: number;
  wallet?: {
    user_id?: string;
    balance_total?: number;
    balance_available?: number;
    balance_pending?: number;
    updated_at?: string;
  };
};

type CrashSeedState = {
  user_id: string;
  server_seed_hash: string;
  client_seed: string;
  nonce_next: number;
  revealed_prev_server_seed: string | null;
  revealed_prev_server_seed_hash: string | null;
};

function fmtMoney(value: unknown) {
  return `$${Number(value ?? 0).toFixed(2)}`;
}

function fmtNum(value: unknown, digits = 2) {
  return Number(value ?? 0).toFixed(digits);
}

function clamp(value: number, min: number, max: number) {
  return Math.min(Math.max(value, min), max);
}

export default function CrashPage() {
  const router = useRouter();
  const [authUser, setAuthUser] = useState<AuthUser | null>(null);
  const [authReady, setAuthReady] = useState(false);

  const [betAmount, setBetAmount] = useState("1.00");
  const [autoCashout, setAutoCashout] = useState("2.00");
  const [betId, setBetId] = useState("");
  const [loading, setLoading] = useState(false);
  const [cashingOut, setCashingOut] = useState(false);
  const [bets, setBets] = useState<CrashBetsResponse | null>(null);
  const [rounds, setRounds] = useState<CrashRoundsResponse | null>(null);
  const [lastAction, setLastAction] = useState<CrashBetResponse | null>(null);
  const [error, setError] = useState("");

  const [autoMode, setAutoMode] = useState(false);
  const [autoBetCount, setAutoBetCount] = useState("10");
  const [stopOnProfit, setStopOnProfit] = useState("0");
  const [stopOnLoss, setStopOnLoss] = useState("0");
  const [sessionProfit, setSessionProfit] = useState(0);
  const [autoRunning, setAutoRunning] = useState(false);

  const [showFairPanel, setShowFairPanel] = useState(false);
  const [seedState, setSeedState] = useState<CrashSeedState | null>(null);
  const [seedLoading, setSeedLoading] = useState(false);
  const [seedError, setSeedError] = useState("");
  const [clientSeedInput, setClientSeedInput] = useState("");
  const [seedActionLoading, setSeedActionLoading] = useState(false);
  const [seedActionMessage, setSeedActionMessage] = useState("");

  const [animatedMultiplier, setAnimatedMultiplier] = useState(1);
  const [graphPhase, setGraphPhase] = useState<"idle" | "running" | "completed" | "crashed">("idle");

  const userId = authUser?.user_id ?? "";
  const { wallet, refreshWallet } = useWallet(userId, 4000);

  useEffect(() => {
    const stored = getStoredUser();
    if (!stored) {
      router.replace("/login");
      return;
    }
    setAuthUser(stored);
    setAuthReady(true);
  }, [router]);

  function tryExtractBetId(data: unknown): string {
    if (!data || typeof data !== "object") return "";
    const obj = data as Record<string, unknown>;
    const direct = obj.bet_id ?? obj.id ?? obj.betId ?? obj.betID;
    if (typeof direct === "number" || typeof direct === "string") {
      return String(direct);
    }
    return "";
  }

  async function loadState(currentUserId = userId) {
    if (!currentUserId) return;

    try {
      const [betsData, roundsData] = await Promise.all([
        apiGet(API_ENDPOINTS.crashBets(currentUserId)),
        apiGet(API_ENDPOINTS.crashRounds(currentUserId)),
      ]);

      setBets(betsData as CrashBetsResponse);
      setRounds(roundsData as CrashRoundsResponse);
      setError("");
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to load crash data");
    }
  }

  async function loadSeedState(currentUserId = userId) {
    if (!currentUserId) return;

    setSeedLoading(true);
    setSeedError("");

    try {
      const data = await apiGet(API_ENDPOINTS.crashSeed(currentUserId));
      const typed = data as CrashSeedState;
      setSeedState(typed);
      setClientSeedInput(typed.client_seed || "");
    } catch (err) {
      setSeedError(err instanceof Error ? err.message : "Failed to load crash seed");
    } finally {
      setSeedLoading(false);
    }
  }

  useEffect(() => {
    if (!userId) return;
    loadState(userId);
    loadSeedState(userId);
    const timer = setInterval(() => loadState(userId), 3000);
    return () => clearInterval(timer);
  }, [userId]);

  const recentRounds = useMemo(() => rounds?.rounds?.slice(0, 8) ?? [], [rounds]);
  const recentBets = useMemo(() => bets?.bets?.slice(0, 8) ?? [], [bets]);
  const latestRound = recentRounds[0] ?? null;

  useEffect(() => {
    if (!latestRound) {
      setGraphPhase("idle");
      setAnimatedMultiplier(1);
      return;
    }

    const latestStatus = String(latestRound.status ?? "").toLowerCase();
    const targetCrash = Number(latestRound.crash_point ?? 1);

    if (latestStatus === "running") {
      setGraphPhase("running");
      setAnimatedMultiplier(1);

      let current = 1;
      const timer = setInterval(() => {
        current = Number((current + Math.max(0.03, current * 0.035)).toFixed(2));
        if (current >= targetCrash) {
          current = targetCrash;
          setAnimatedMultiplier(current);
          clearInterval(timer);
          setGraphPhase("crashed");
          return;
        }
        setAnimatedMultiplier(current);
      }, 120);

      return () => clearInterval(timer);
    }

    setAnimatedMultiplier(targetCrash);

    if (latestStatus === "completed" || latestStatus === "cashed_out") {
      setGraphPhase("completed");
    } else if (latestStatus === "crashed" || latestStatus === "lost") {
      setGraphPhase("crashed");
    } else {
      setGraphPhase("idle");
    }
  }, [latestRound?.id, latestRound?.status, latestRound?.crash_point]);

  async function handlePlaceBet() {
    if (!userId) return;

    setLoading(true);
    setError("");

    try {
      const payload = {
        user_id: userId,
        amount_usd: Number(betAmount),
        auto_cashout: autoCashout.trim() ? Number(autoCashout) : undefined,
      };

      const data = await apiPost(API_ENDPOINTS.crashBet, payload);
      const typed = data as CrashBetResponse;
      setLastAction(typed);

      const extractedBetId = tryExtractBetId(data);
      if (extractedBetId) {
        setBetId(extractedBetId);
      }

      const payout = Number(typed.payout ?? 0);
      const stake = Number(typed.amount_usd ?? betAmount ?? 0);
      const estimatedProfit = payout > 0 ? payout - stake : -stake;
      setSessionProfit((prev) => Number((prev + estimatedProfit).toFixed(2)));

      await Promise.all([loadState(userId), loadSeedState(userId), refreshWallet(userId)]);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to place crash bet");
    } finally {
      setLoading(false);
    }
  }

  async function handleCashout() {
    if (!userId) return;

    if (!betId.trim()) {
      setError("Enter a bet ID first for cashout.");
      return;
    }

    setCashingOut(true);
    setError("");

    try {
      const data = await apiPost(API_ENDPOINTS.crashCashout(betId.trim()), {});
      const typed = data as CrashBetResponse;
      setLastAction(typed);

      const payout = Number(typed.payout ?? 0);
      const matchingBet = recentBets.find((b) => String(b.id) === betId.trim());
      const stake = Number(matchingBet?.amount_usd ?? 0);
      const estimatedProfit = payout > 0 ? payout - stake : -stake;
      if (stake > 0 || payout > 0) {
        setSessionProfit((prev) => Number((prev + estimatedProfit).toFixed(2)));
      }

      await Promise.all([loadState(userId), refreshWallet(userId)]);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Failed to cash out");
    } finally {
      setCashingOut(false);
    }
  }

  async function handleAutoBet() {
    if (autoRunning || loading || cashingOut) return;

    const rolls = Math.max(1, Number(autoBetCount || "1"));
    const stopProfitValue = Number(stopOnProfit || "0");
    const stopLossValue = Number(stopOnLoss || "0");

    setAutoRunning(true);
    setError("");

    let total = 0;

    for (let i = 0; i < rolls; i++) {
      try {
        const payload = {
          user_id: userId,
          amount_usd: Number(betAmount),
          auto_cashout: autoCashout.trim() ? Number(autoCashout) : undefined,
        };

        const data = await apiPost(API_ENDPOINTS.crashBet, payload);
        const typed = data as CrashBetResponse;
        setLastAction(typed);

        const extractedBetId = tryExtractBetId(data);
        if (extractedBetId) {
          setBetId(extractedBetId);
        }

        const payout = Number(typed.payout ?? 0);
        const stake = Number(typed.amount_usd ?? betAmount ?? 0);
        const profit = payout > 0 ? payout - stake : -stake;

        total = Number((total + profit).toFixed(2));
        setSessionProfit((prev) => Number((prev + profit).toFixed(2)));

        await Promise.all([loadState(userId), loadSeedState(userId), refreshWallet(userId)]);

        if (stopProfitValue > 0 && total >= stopProfitValue) break;
        if (stopLossValue > 0 && total <= -Math.abs(stopLossValue)) break;

        await new Promise((resolve) => setTimeout(resolve, 400));
      } catch (err) {
        setError(err instanceof Error ? err.message : "Auto bet failed");
        break;
      }
    }

    setAutoRunning(false);
  }

  async function handleSetClientSeed() {
    if (!userId) return;
    if (!clientSeedInput.trim()) {
      setSeedError("Client seed is required.");
      return;
    }

    setSeedActionLoading(true);
    setSeedActionMessage("");
    setSeedError("");

    try {
      const data = await apiPost(API_ENDPOINTS.crashSetClientSeed(userId), {
        client_seed: clientSeedInput.trim(),
      });
      setSeedActionMessage(`Client seed updated to: ${String((data as { client_seed?: string }).client_seed ?? "")}`);
      await loadSeedState(userId);
    } catch (err) {
      setSeedError(err instanceof Error ? err.message : "Failed to set client seed");
    } finally {
      setSeedActionLoading(false);
    }
  }

  async function handleRotateSeed() {
    if (!userId) return;

    setSeedActionLoading(true);
    setSeedActionMessage("");
    setSeedError("");

    try {
      const data = await apiPost(API_ENDPOINTS.crashRotateSeed(userId), {});
      const typed = data as {
        new_server_seed_hash?: string;
        revealed_prev_server_seed?: string;
      };

      setSeedActionMessage(`Server seed rotated. New hash: ${typed.new_server_seed_hash ?? "-"}`);
      await loadSeedState(userId);
      await loadState(userId);
    } catch (err) {
      setSeedError(err instanceof Error ? err.message : "Failed to rotate server seed");
    } finally {
      setSeedActionLoading(false);
    }
  }

  function setQuickBet(mode: "half" | "double" | "max") {
    const current = Number(betAmount || "0");
    if (mode === "half") setBetAmount(Math.max(0.1, current / 2).toFixed(2));
    if (mode === "double") setBetAmount(Math.max(0.1, current * 2).toFixed(2));
    if (mode === "max") setBetAmount("100.00");
  }

  const isWin =
    (lastAction?.payout ?? 0) > 0 ||
    String(lastAction?.status ?? "").toLowerCase() === "won" ||
    String(lastAction?.status ?? "").toLowerCase() === "cashed_out";

  const graphLineWidth = `${clamp((animatedMultiplier / 10) * 100, 18, 96)}%`;
  const graphLineRotation = `${clamp(12 + animatedMultiplier * 2.5, 12, 42)}deg`;
  const graphColor =
    graphPhase === "completed"
      ? "linear-gradient(90deg, #22c55e, #86efac)"
      : graphPhase === "crashed"
      ? "linear-gradient(90deg, #ef4444, #fca5a5)"
      : "linear-gradient(90deg, #22c55e, #86efac)";

  if (!authReady) {
    return (
      <div style={loadingPageStyle}>
        <div style={loadingCardStyle}>Loading player session...</div>
      </div>
    );
  }

  return (
    <PlayerShell
      title="Crash"
      subtitle="Coin2Win Originals – upgraded crash controls and provably fair tools."
    >
      <div style={containerStyle}>
        <section style={heroStyle}>
          <div style={heroLeftStyle}>
            <div style={eyebrowStyle}>COIN2WIN ORIGINAL</div>
            <h1 style={titleStyle}>Crash Game</h1>
            <p style={descStyle}>
              Upgraded controls, animated crash display, auto-bet flow, and seed management.
            </p>
          </div>

          <div style={heroRightStyle}>
            <div style={statCardStyle}>
              <div style={statLabelStyle}>Player</div>
              <div style={statValueStyle}>{authUser?.username ?? "-"}</div>
            </div>
            <div style={statCardStyle}>
              <div style={statLabelStyle}>Wallet Available</div>
              <div style={statValueStyle}>{fmtMoney(wallet?.balance_available)}</div>
            </div>
            <div style={statCardStyle}>
              <div style={statLabelStyle}>Session Profit</div>
              <div style={{ ...statValueStyle, color: sessionProfit >= 0 ? "#86efac" : "#fca5a5" }}>
                {sessionProfit >= 0 ? "+" : ""}
                {fmtMoney(sessionProfit).replace("$", "")}
              </div>
            </div>
          </div>
        </section>

        <section style={walletBarStyle}>
          <div style={walletMiniCardStyle}>
            <span style={walletMiniLabelStyle}>Username</span>
            <strong>{authUser?.username ?? "-"}</strong>
          </div>
          <div style={walletMiniCardStyle}>
            <span style={walletMiniLabelStyle}>User ID</span>
            <strong style={smallWrapStyle}>{authUser?.user_id ?? "-"}</strong>
          </div>
          <div style={walletMiniCardStyle}>
            <span style={walletMiniLabelStyle}>Available</span>
            <strong>{fmtMoney(wallet?.balance_available)}</strong>
          </div>
        </section>

        <section style={panelStyle}>
          <div style={panelHeaderRowStyle}>
            <h2 style={panelTitleStyle}>Crash Controls</h2>
            <button
              type="button"
              style={darkButtonStyle}
              onClick={() => setShowFairPanel((prev) => !prev)}
            >
              {showFairPanel ? "Hide Provably Fair" : "Provably Fair"}
            </button>
          </div>

          {error ? <div style={errorStyle}>{error}</div> : null}

          <div style={gameShellStyle}>
            <div style={graphStyle}>
              <div
                style={{
                  ...graphGlowStyle,
                  background:
                    graphPhase === "crashed"
                      ? "rgba(239,68,68,0.18)"
                      : "rgba(34,197,94,0.18)",
                }}
              />
              <div
                style={{
                  ...graphLineStyle,
                  width: graphLineWidth,
                  background: graphColor,
                  transform: `skewY(-${graphLineRotation})`,
                  boxShadow:
                    graphPhase === "crashed"
                      ? "0 0 18px rgba(239,68,68,0.5)"
                      : "0 0 18px rgba(34,197,94,0.5)",
                }}
              />
              <div style={graphCenterStyle}>
                <div style={graphLiveLabelStyle}>LIVE ROUND</div>
                <div style={graphMultiplierStyle}>
                  {fmtNum(animatedMultiplier)}x
                </div>
                <div style={graphStatusStyle}>
                  {latestRound?.status ? String(latestRound.status).toUpperCase() : "WAITING"}
                </div>
                <div style={graphSubStyle}>
                  Actual Latest Crash: {latestRound ? `${fmtNum(latestRound.crash_point)}x` : "-"}
                </div>
              </div>
            </div>

            <div style={controlsStyle}>
              <div style={controlCardStyle}>
                <div style={controlLabelStyle}>Player</div>
                <div style={readonlyBoxStyle}>{authUser?.username} ({authUser?.user_id})</div>
              </div>

              <div style={controlCardStyle}>
                <div style={controlLabelStyle}>Bet Amount (USD)</div>
                <input
                  style={inputStyle}
                  value={betAmount}
                  onChange={(e) => setBetAmount(e.target.value)}
                  inputMode="decimal"
                />
                <div style={quickRowStyle}>
                  <button type="button" style={miniButtonStyle} onClick={() => setQuickBet("half")}>½</button>
                  <button type="button" style={miniButtonStyle} onClick={() => setQuickBet("double")}>2x</button>
                  <button type="button" style={miniButtonStyle} onClick={() => setQuickBet("max")}>Max</button>
                </div>
              </div>

              <div style={controlCardStyle}>
                <div style={controlLabelStyle}>Auto Cashout</div>
                <input
                  style={inputStyle}
                  value={autoCashout}
                  onChange={(e) => setAutoCashout(e.target.value)}
                  inputMode="decimal"
                />
              </div>

              <div style={controlCardStyle}>
                <div style={controlLabelStyle}>Bet ID for Cashout</div>
                <input
                  style={inputStyle}
                  value={betId}
                  onChange={(e) => setBetId(e.target.value)}
                />
              </div>

              <div style={controlCardStyle}>
                <label style={toggleRowStyle}>
                  <span style={controlLabelStyle}>Auto Bet Mode</span>
                  <input
                    type="checkbox"
                    checked={autoMode}
                    onChange={(e) => setAutoMode(e.target.checked)}
                  />
                </label>

                {autoMode ? (
                  <div style={autoBoxStyle}>
                    <div>
                      <div style={subLabelStyle}>Number of Bets</div>
                      <input
                        style={inputStyle}
                        value={autoBetCount}
                        onChange={(e) => setAutoBetCount(e.target.value)}
                        inputMode="numeric"
                      />
                    </div>

                    <div>
                      <div style={subLabelStyle}>Stop on Profit</div>
                      <input
                        style={inputStyle}
                        value={stopOnProfit}
                        onChange={(e) => setStopOnProfit(e.target.value)}
                        inputMode="decimal"
                      />
                    </div>

                    <div>
                      <div style={subLabelStyle}>Stop on Loss</div>
                      <input
                        style={inputStyle}
                        value={stopOnLoss}
                        onChange={(e) => setStopOnLoss(e.target.value)}
                        inputMode="decimal"
                      />
                    </div>
                  </div>
                ) : null}
              </div>

              <div style={buttonStackStyle}>
                {!autoMode ? (
                  <button
                    type="button"
                    style={greenButtonStyle}
                    onClick={handlePlaceBet}
                    disabled={loading}
                  >
                    {loading ? "Placing Bet..." : "Place Bet"}
                  </button>
                ) : (
                  <button
                    type="button"
                    style={greenButtonStyle}
                    onClick={handleAutoBet}
                    disabled={autoRunning}
                  >
                    {autoRunning ? "Auto Betting..." : "Start Auto Bet"}
                  </button>
                )}

                <button
                  type="button"
                  style={darkButtonStyle}
                  onClick={handleCashout}
                  disabled={cashingOut}
                >
                  {cashingOut ? "Cashing Out..." : "Cash Out"}
                </button>

                <button
                  type="button"
                  style={darkButtonStyle}
                  onClick={() => Promise.all([loadState(userId), loadSeedState(userId), refreshWallet(userId)])}
                >
                  Refresh
                </button>
              </div>
            </div>
          </div>
        </section>

        {showFairPanel ? (
          <section style={historyCardStyle}>
            <div style={historyHeaderStyle}>
              <h3 style={sectionTitleStyle}>Provably Fair & Seed Controls</h3>
            </div>

            {seedLoading ? (
              <div style={emptyStyle}>Loading crash seed state...</div>
            ) : seedError ? (
              <div style={errorStyle}>{seedError}</div>
            ) : seedState ? (
              <>
                <div style={seedGridStyle}>
                  <InfoCard label="Current Server Seed Hash" value={seedState.server_seed_hash || "-"} />
                  <InfoCard label="Current Client Seed" value={seedState.client_seed || "-"} />
                  <InfoCard label="Next Nonce" value={String(seedState.nonce_next ?? "-")} />
                  <InfoCard
                    label="Revealed Previous Server Seed"
                    value={seedState.revealed_prev_server_seed || "Not revealed yet"}
                  />
                  <InfoCard
                    label="Revealed Previous Seed Hash"
                    value={seedState.revealed_prev_server_seed_hash || "Not revealed yet"}
                  />
                </div>

                <div style={seedActionWrapStyle}>
                  <div>
                    <div style={subLabelStyle}>Set Client Seed</div>
                    <input
                      style={inputStyle}
                      value={clientSeedInput}
                      onChange={(e) => setClientSeedInput(e.target.value)}
                      placeholder="Enter custom client seed"
                    />
                  </div>

                  <div style={seedButtonRowStyle}>
                    <button
                      type="button"
                      style={greenButtonStyle}
                      onClick={handleSetClientSeed}
                      disabled={seedActionLoading}
                    >
                      {seedActionLoading ? "Saving..." : "Save Client Seed"}
                    </button>

                    <button
                      type="button"
                      style={amberButtonStyle}
                      onClick={handleRotateSeed}
                      disabled={seedActionLoading}
                    >
                      {seedActionLoading ? "Rotating..." : "Rotate Server Seed"}
                    </button>

                    <button
                      type="button"
                      style={darkButtonStyle}
                      onClick={() => loadSeedState(userId)}
                    >
                      Refresh Seed State
                    </button>
                  </div>

                  {seedActionMessage ? (
                    <div style={successStyle}>{seedActionMessage}</div>
                  ) : null}
                </div>
              </>
            ) : (
              <div style={emptyStyle}>No seed state found.</div>
            )}
          </section>
        ) : null}

        <section style={resultsGridStyle}>
          <div style={resultCardStyle}>
            <h3 style={sectionTitleStyle}>Last Crash Result</h3>

            {lastAction ? (
              <>
                <div style={resultBannerStyle(isWin)}>
                  {isWin ? "WON" : "LOST"}
                </div>

                <div style={kvListStyle}>
                  <div style={kvRowStyle}><span>Bet ID</span><strong>{lastAction.bet_id ?? "-"}</strong></div>
                  <div style={kvRowStyle}><span>Round ID</span><strong>{lastAction.round_id ?? "-"}</strong></div>
                  <div style={kvRowStyle}><span>Amount</span><strong>{fmtMoney(lastAction.amount_usd)}</strong></div>
                  <div style={kvRowStyle}><span>Auto Cashout</span><strong>{lastAction.auto_cashout ? `${fmtNum(lastAction.auto_cashout)}x` : "-"}</strong></div>
                  <div style={kvRowStyle}><span>Crash Point</span><strong>{lastAction.crash_point ? `${fmtNum(lastAction.crash_point)}x` : "-"}</strong></div>
                  <div style={kvRowStyle}><span>Status</span><strong>{String(lastAction.status ?? "-")}</strong></div>
                  <div style={kvRowStyle}><span>Payout</span><strong>{fmtMoney(lastAction.payout)}</strong></div>
                </div>
              </>
            ) : (
              <div style={emptyStyle}>No crash bet yet.</div>
            )}
          </div>

          <div style={resultCardStyle}>
            <h3 style={sectionTitleStyle}>Provably Fair Summary</h3>

            {lastAction ? (
              <div style={kvListStyle}>
                <div style={kvRowStyle}>
                  <span>Client Seed</span>
                  <strong>{String(lastAction.client_seed ?? "-")}</strong>
                </div>
                <div style={kvRowStyle}>
                  <span>Nonce</span>
                  <strong>{String(lastAction.nonce ?? "-")}</strong>
                </div>
                <div style={kvRowStyle}>
                  <span>Server Seed Hash</span>
                  <strong style={hashStyle}>{String(lastAction.server_seed_hash ?? "-")}</strong>
                </div>
              </div>
            ) : (
              <div style={emptyStyle}>Place a bet to see fairness details.</div>
            )}
          </div>
        </section>

        <section style={historyCardStyle}>
          <div style={historyHeaderStyle}>
            <h3 style={sectionTitleStyle}>Recent Rounds</h3>
            <div style={historyCountStyle}>{rounds?.count ?? 0} total</div>
          </div>

          {recentRounds.length ? (
            <div style={tableWrapStyle}>
              <table style={tableStyle}>
                <thead>
                  <tr>
                    <th style={thStyle}>Round</th>
                    <th style={thStyle}>Crash Point</th>
                    <th style={thStyle}>Status</th>
                    <th style={thStyle}>Nonce</th>
                    <th style={thStyle}>Client Seed</th>
                  </tr>
                </thead>
                <tbody>
                  {recentRounds.map((round) => (
                    <tr key={round.id}>
                      <td style={tdStyle}>{round.id}</td>
                      <td style={tdStyle}>{fmtNum(round.crash_point)}x</td>
                      <td style={tdStyle}>
                        <span style={statusPillStyle(String(round.status ?? ""))}>
                          {round.status}
                        </span>
                      </td>
                      <td style={tdStyle}>{round.nonce ?? "-"}</td>
                      <td style={tdStyle}>{round.client_seed ?? "-"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div style={emptyStyle}>No rounds found.</div>
          )}
        </section>

        <section style={historyCardStyle}>
          <div style={historyHeaderStyle}>
            <h3 style={sectionTitleStyle}>Recent Bets</h3>
            <div style={historyCountStyle}>{bets?.count ?? 0} total</div>
          </div>

          {recentBets.length ? (
            <div style={tableWrapStyle}>
              <table style={tableStyle}>
                <thead>
                  <tr>
                    <th style={thStyle}>Bet</th>
                    <th style={thStyle}>Amount</th>
                    <th style={thStyle}>Auto</th>
                    <th style={thStyle}>Crash</th>
                    <th style={thStyle}>Status</th>
                    <th style={thStyle}>Payout</th>
                  </tr>
                </thead>
                <tbody>
                  {recentBets.map((bet) => (
                    <tr key={bet.id}>
                      <td style={tdStyle}>{bet.id}</td>
                      <td style={tdStyle}>{fmtMoney(bet.amount_usd)}</td>
                      <td style={tdStyle}>{bet.auto_cashout ? `${fmtNum(bet.auto_cashout)}x` : "-"}</td>
                      <td style={tdStyle}>{bet.crash_point ? `${fmtNum(bet.crash_point)}x` : "-"}</td>
                      <td style={tdStyle}>
                        <span style={statusPillStyle(String(bet.status ?? ""))}>
                          {bet.status ?? "-"}
                        </span>
                      </td>
                      <td style={tdStyle}>{fmtMoney(bet.payout)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div style={emptyStyle}>No bets found.</div>
          )}
        </section>
      </div>
    </PlayerShell>
  );
}

function InfoCard({ label, value }: { label: string; value: string }) {
  return (
    <div style={infoCardStyle}>
      <div style={infoLabelStyle}>{label}</div>
      <div style={infoValueStyle}>{value}</div>
    </div>
  );
}

