"use client";

import Link from "next/link";
import { useEffect, useMemo, useState } from "react";

type Category = "originals" | "slots" | "live";

type GameCard = {
  name: string;
  slug: string;
  category: Category;
  accent: string;
  description: string;
  badge?: string;
};

const GAMES: GameCard[] = [
  {
    name: "Dice",
    slug: "/dice",
    category: "originals",
    accent: "linear-gradient(135deg, rgba(34,197,94,0.28), rgba(14,165,233,0.18))",
    description: "Fast rolls, clean controls, instant action.",
    badge: "Original",
  },
  {
    name: "Crash",
    slug: "/crash",
    category: "originals",
    accent: "linear-gradient(135deg, rgba(239,68,68,0.28), rgba(245,158,11,0.18))",
    description: "Ride the multiplier and cash out in time.",
    badge: "Hot",
  },
  {
    name: "Slots",
    slug: "#",
    category: "slots",
    accent: "linear-gradient(135deg, rgba(168,85,247,0.24), rgba(59,130,246,0.16))",
    description: "More games coming soon.",
    badge: "Soon",
  },
  {
    name: "Live Casino",
    slug: "#",
    category: "live",
    accent: "linear-gradient(135deg, rgba(14,165,233,0.24), rgba(99,102,241,0.18))",
    description: "Table action coming soon.",
    badge: "Soon",
  },
];

export default function CasinoLobbyPage() {
  const [category, setCategory] = useState<Category>("originals");
  const [isMobile, setIsMobile] = useState(false);

  useEffect(() => {
    if (typeof window !== "undefined") {
      const sync = () => setIsMobile(window.innerWidth < 768);
      sync();
      window.addEventListener("resize", sync);
    }
  });

  const visibleGames = useMemo(
    () => GAMES.filter((game) => game.category === category),
    [category]
  );

  return (
    <div
      style={{
        minHeight: "100%",
        color: "#fff",
        padding: "16px",
        display: "grid",
        gap: "16px",
      }}
    >
      <div
        style={{
          display: "grid",
          gap: "10px",
          background: "linear-gradient(180deg, rgba(15,23,42,0.96), rgba(17,24,39,0.96))",
          border: "1px solid rgba(255,255,255,0.08)",
          borderRadius: "18px",
          padding: "18px",
          boxShadow: "0 18px 40px rgba(0,0,0,0.28)",
        }}
      >
        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            gap: "12px",
            flexWrap: "wrap",
          }}
        >
          <div>
            <div style={{ fontSize: "24px", fontWeight: 900, letterSpacing: "-0.02em" }}>
              Casino
            </div>
            <div style={{ fontSize: "14px", color: "#94a3b8", marginTop: "4px" }}>
              Originals first. More categories coming online soon.
            </div>
          </div>

          <div
            style={{
              padding: "10px 12px",
              borderRadius: "12px",
              background: "#0b1220",
              border: "1px solid rgba(255,255,255,0.06)",
              minWidth: "140px",
            }}
          >
            <div style={{ fontSize: "11px", color: "#94a3b8", marginBottom: "3px" }}>
              Status
            </div>
            <div style={{ fontWeight: 800, fontSize: "14px" }}>Lobby Live</div>
          </div>
        </div>

        <div style={{ display: "flex", gap: "10px", flexWrap: "wrap" }}>
          {(["originals", "slots", "live"] as Category[]).map((tab) => {
            const active = category === tab;
            return (
              <button
                key={tab}
                onClick={() => setCategory(tab)}
                style={{
                  padding: "10px 14px",
                  borderRadius: "12px",
                  border: active ? "1px solid rgba(14,165,233,0.55)" : "1px solid rgba(255,255,255,0.08)",
                  background: active ? "rgba(14,165,233,0.18)" : "#111827",
                  color: "#fff",
                  fontWeight: 800,
                  cursor: "pointer",
                  transition: "all 180ms ease",
                }}
              >
                {tab === "originals" ? "Originals" : tab === "slots" ? "Slots" : "Live"}
              </button>
            );
          })}
        </div>
      </div>

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(220px, 1fr))",
          gap: "16px",
        }}
      >
        {visibleGames.map((game) => {
          const disabled = game.slug === "#";

          const cardInner = (
            <div
              style={{
                position: "relative",
                overflow: "hidden",
                minHeight: "220px",
                borderRadius: "18px",
                border: "1px solid rgba(255,255,255,0.08)",
                background: "#111827",
                boxShadow: "0 14px 32px rgba(0,0,0,0.24)",
                transform: "translateY(0px)",
                transition: "transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease",
              }}
              className="casino-card"
            >
              <div
                style={{
                  position: "absolute",
                  inset: 0,
                  background: game.accent,
                }}
              />
              <div
                style={{
                  position: "absolute",
                  inset: 0,
                  background:
                    "radial-gradient(circle at top right, rgba(255,255,255,0.10), transparent 35%)",
                }}
              />
              <div
                style={{
                  position: "relative",
                  zIndex: 1,
                  height: "100%",
                  padding: "16px",
                  display: "grid",
                  gridTemplateRows: "auto 1fr auto",
                  gap: "14px",
                }}
              >
                <div
                  style={{
                    display: "flex",
                    justifyContent: "space-between",
                    alignItems: "flex-start",
                    gap: "8px",
                  }}
                >
                  <div
                    style={{
                      width: "54px",
                      height: "54px",
                      borderRadius: "16px",
                      background: "rgba(2,6,23,0.72)",
                      border: "1px solid rgba(255,255,255,0.08)",
                      display: "grid",
                      placeItems: "center",
                      fontSize: "20px",
                      fontWeight: 900,
                    }}
                  >
                    {game.name === "Dice" ? "🎲" : game.name === "Crash" ? "🚀" : game.name === "Slots" ? "🎰" : "🎥"}
                  </div>

                  {game.badge ? (
                    <div
                      style={{
                        fontSize: "11px",
                        fontWeight: 800,
                        padding: "6px 8px",
                        borderRadius: "999px",
                        background: "rgba(2,6,23,0.72)",
                        border: "1px solid rgba(255,255,255,0.08)",
                      }}
                    >
                      {game.badge}
                    </div>
                  ) : null}
                </div>

                <div>
                  <div style={{ fontSize: "22px", fontWeight: 900, letterSpacing: "-0.02em" }}>
                    {game.name}
                  </div>
                  <div style={{ fontSize: "13px", color: "#cbd5e1", marginTop: "8px", lineHeight: 1.5 }}>
                    {game.description}
                  </div>
                </div>

                <div
                  style={{
                    display: "flex",
                    justifyContent: "space-between",
                    alignItems: "center",
                    gap: "10px",
                  }}
                >
                  <div style={{ fontSize: "12px", color: "#cbd5e1" }}>
                    {disabled ? "Coming soon" : "Play now"}
                  </div>
                  <div
                    style={{
                      padding: "10px 12px",
                      borderRadius: "12px",
                      background: disabled ? "rgba(255,255,255,0.08)" : "rgba(2,6,23,0.72)",
                      border: "1px solid rgba(255,255,255,0.08)",
                      fontSize: "12px",
                      fontWeight: 800,
                    }}
                  >
                    {disabled ? "Soon" : "Enter"}
                  </div>
                </div>
              </div>
            </div>
          );

          if (disabled) {
            return <div key={game.name}>{cardInner}</div>;
          }

          return (
            <Link
              key={game.name}
              href={game.slug}
              style={{ textDecoration: "none", color: "inherit" }}
            >
              {cardInner}
            </Link>
          );
        })}
      </div>

      <style jsx>{`
        .casino-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 20px 38px rgba(0, 0, 0, 0.32);
          border-color: rgba(255, 255, 255, 0.14);
        }
      `}</style>
    </div>
  );
}
